{
  "name": "protein-cellular-agent-swarm",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-09",
  "durable_objects": {
    "bindings": [
      { "name": "SWARM_CELL", "class_name": "SwarmCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SwarmCell"] }
  ],
  "vars": {
    "EXECUTOR_URL": "http://127.0.0.1:19110",
    "BOARD_URL": "http://127.0.0.1:19111",
    "PROTEIN_LEASE_MS": "3000"
  }
}
